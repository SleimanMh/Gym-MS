# Copy to .env at the repo root for local development (read by the API, worker, db scripts and tests).

# --- Database -------------------------------------------------------------
# The API connects as gym_app: NOT the table owner, NOBYPASSRLS, so Row-Level Security always applies.
DATABASE_URL=postgresql://gym_app:gym_app_dev@localhost:5433/gym?schema=public
# Integration tests use their own database so they never touch demo data (apps/api/test/load-env.js).
# Create it like the main one (see infra/docker/postgres/init.sql), then migrate + seed it.
TEST_DATABASE_URL=postgresql://gym_app:gym_app_dev@localhost:5433/gym_test?schema=public
# Migrations and seed connect as gym_owner (owns the tables). Never used by the running API.
DATABASE_OWNER_URL=postgresql://gym_owner:gym_owner_dev@localhost:5433/gym?schema=public

# --- Redis / queues -------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Comma-separated origins allowed to call the staff API (the admin app).
ADMIN_ORIGINS=http://localhost:3000
# Root domain used for subdomain tenant resolution: ironfit.<APP_ROOT_DOMAIN>
APP_ROOT_DOMAIN=localhost

# --- Auth (Keycloak) ------------------------------------------------------
KEYCLOAK_ISSUER=http://localhost:8080/realms/gym
KEYCLOAK_AUDIENCE=gym-api
# Development-only HS256 tokens minted by POST /v1/dev/token. Refused when NODE_ENV=production.
AUTH_DEV_TOKENS=true
DEV_JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# Service account the worker uses to create staff accounts and send set-password emails
# (client "gym-api-admin" in infra/keycloak/realm-gym.json). Leave the secret empty to skip invitations.
KEYCLOAK_ADMIN_CLIENT_ID=gym-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-keycloak-admin-secret
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080   # when the API/worker run inside Docker

# --- Admin app (copy these to apps/admin/.env.local: Next.js reads env from its own folder) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Staff sign-in (defaults shown). DEV_LOGIN=false hides the seeded-user picker.
# KEYCLOAK_ISSUER=http://localhost:8080/realms/gym
# KEYCLOAK_CLIENT_ID=gym-admin
# APP_URL=http://localhost:3000
# DEV_LOGIN=true
# Widget script for hosted pages and the embed snippet. Dev: the Vite dev server; prod: the CDN bundle.
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173/src/index.ts

# --- Object storage (MinIO locally) --------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gym-files
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_secret

# --- Email (Mailpit locally) ---------------------------------------------
SMTP_URL=smtp://localhost:1025

# --- Members (widget email-code login) -----------------------------------
MEMBER_JWT_SECRET=change-me-member-session-secret-32-chars-min
CODE_PEPPER=change-me-code-pepper
MAIL_FROM=Gym Manager <no-reply@gym.local>
PUBLIC_APP_URL=http://localhost:3000
